@final
class FdebSolver:
    def __new__(
        cls,
        graph: CsrGraph,
        layout: Layout2d,
        *,
        cycles: int = 6,
        s0: float = 0.1,
        i0: int = 90,
        s_step: float = 0.5,
        i_step: float = 0.6666666666666666,
        spring_k: float = 0.1,
        minimum_edge_compatibility: float = 0.6,
        dtype: _DtypeLike | None = None,
    ) -> FdebSolver: ...
    def step(self) -> str: ...
    def run_steps(self, steps: int) -> str: ...
    def run(self) -> str: ...
    @property
    def status(self) -> str: ...
    @property
    def iteration(self) -> int: ...
    @property
    def total_iterations(self) -> int: ...
    @property
    def is_finished(self) -> bool: ...
    @property
    def num_edges(self) -> int: ...
    @property
    def dtype(self) -> str: ...
    def edge_offsets(self) -> npt.NDArray[np.uint32]: ...
    def points(self) -> npt.NDArray[Any]: ...
    def __repr__(self) -> str: ...

