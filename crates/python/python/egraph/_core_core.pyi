class EgraphError(ValueError): ...
class InvalidInputError(EgraphError): ...
class DimensionMismatchError(EgraphError): ...
class IndexOutOfBoundsError(EgraphError, IndexError): ...
class InvalidCsrError(EgraphError): ...
class NonFiniteValueError(EgraphError): ...
class UnsupportedOperationError(EgraphError): ...
class NumericalBreakdownError(EgraphError): ...

@final
class CsrGraph:
    @staticmethod
    def from_csr(
        indptr: _IndexArrayLike,
        indices: _IndexArrayLike,
        weights: _WeightArrayLike | None = None,
        *,
        directed: bool = False,
        sanitize: bool = True,
        weight_dtype: _DtypeLike = "float64",
    ) -> CsrGraph: ...
    @staticmethod
    def from_edges(
        num_nodes: int,
        edges: _EdgeArrayLike,
        weights: _WeightArrayLike | None = None,
        *,
        directed: bool = False,
        sanitize: bool = True,
        weight_dtype: _DtypeLike = "float64",
    ) -> CsrGraph: ...
    @staticmethod
    def from_edge_list(
        num_nodes: int,
        edges: _EdgeArrayLike,
        weights: _WeightArrayLike | None = None,
        *,
        directed: bool = False,
        sanitize: bool = True,
        weight_dtype: _DtypeLike = "float64",
    ) -> CsrGraph: ...
    def __len__(self) -> int: ...
    @property
    def num_nodes(self) -> int: ...
    @property
    def num_edges(self) -> int: ...
    @property
    def nnz(self) -> int: ...
    @property
    def is_directed(self) -> bool: ...
    @property
    def is_weighted(self) -> bool: ...
    @property
    def weight_dtype(self) -> str: ...
    def degree(self, u: int) -> int: ...
    def neighbors(self, u: int) -> npt.NDArray[np.uint32]: ...
    def edges(self) -> npt.NDArray[np.uint32]: ...
    def has_edge(self, u: int, v: int) -> bool: ...
    def edge_weight(self, u: int, v: int) -> float | None: ...
    def is_connected(self) -> bool: ...
    def induced_subgraph(self, nodes: _IndexArrayLike) -> CsrGraph: ...
    def indptr(self) -> npt.NDArray[np.uint32]: ...
    def indices(self) -> npt.NDArray[np.uint32]: ...
    def weights(self) -> npt.NDArray[Any] | None: ...
    def largest_connected_component(self) -> tuple[CsrGraph, npt.NDArray[np.uint32]]: ...
    def __repr__(self) -> str: ...

@final
class Layout2d:
    @staticmethod
    def zeros(n: int, dtype: _DtypeLike = "float64") -> Layout2d: ...
    @staticmethod
    def init(
        n: int, *, seed: int = 42, scale: float = 1.0, dtype: _DtypeLike = "float64"
    ) -> Layout2d: ...
    @staticmethod
    def from_coords(coords: _CoordArrayLike) -> Layout2d: ...
    def copy(self) -> Layout2d: ...
    def __len__(self) -> int: ...
    @property
    def num_nodes(self) -> int: ...
    def is_empty(self) -> bool: ...
    def x(self, i: int) -> float: ...
    def y(self, i: int) -> float: ...
    def set_x(self, i: int, v: float) -> None: ...
    def set_y(self, i: int, v: float) -> None: ...
    def normalize_std(self, target_std: float = 1.0) -> None: ...
    @property
    def dtype(self) -> str: ...
    def is_all_finite(self) -> bool: ...
    def copy_coords(self) -> npt.NDArray[Any]: ...
    def coords(self, copy: bool = False) -> npt.NDArray[Any]: ...
    def __repr__(self) -> str: ...

