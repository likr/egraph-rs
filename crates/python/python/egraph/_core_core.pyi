@final
class ArenaOctree3d:
    def __new__(cls, dtype: _DtypeLike = "float64") -> ArenaOctree3d: ...
    @property
    def dtype(self) -> str: ...
    @property
    def point_count(self) -> int: ...
    @property
    def node_count(self) -> int: ...
    def __len__(self) -> int: ...
    def build(
        self,
        coords_or_layout: Layout3d | LayoutNd | _CoordArrayLike,
        *,
        masses: _WeightArrayLike | None = None,
    ) -> None: ...
    def build_xyz(
        self,
        x: _WeightArrayLike,
        y: _WeightArrayLike,
        z: _WeightArrayLike,
        *,
        masses: _WeightArrayLike | None = None,
    ) -> None: ...
    def clear(self) -> None: ...
    def compute_coulomb_repulsion(
        self, *, theta: float = 0.5, eps_sq: float = 1e-6
    ) -> npt.NDArray[Any]: ...
    def compute_maxent_repulsion(
        self, q: float, *, theta: float = 0.5, eps_sq: float = 1e-6
    ) -> npt.NDArray[Any]: ...
    def compute_kl_repulsion(
        self, *, theta: float = 0.5
    ) -> tuple[npt.NDArray[Any], float]: ...
    def compute_entropy_repulsion(
        self, *, theta: float = 0.5, epsilon_r: float = 0.05
    ) -> npt.NDArray[Any]: ...
    def __repr__(self) -> str: ...

@final
class DynamicKdTree:
    def __new__(cls, coords_or_layout: LayoutNd | _CoordArrayLike) -> DynamicKdTree: ...
    @property
    def dims(self) -> int: ...
    @property
    def num_nodes(self) -> int: ...
    def __len__(self) -> int: ...
    def is_empty(self) -> bool: ...
    def point(self, index: int) -> npt.NDArray[np.float64]: ...
    def k_nearest(
        self, query: _WeightArrayLike, k: int
    ) -> tuple[npt.NDArray[np.uintp], npt.NDArray[np.float64]]: ...
    def k_nearest_excluding_self(
        self, index: int, k: int
    ) -> tuple[npt.NDArray[np.uintp], npt.NDArray[np.float64]]: ...
    def nearest_excluding_self(self, index: int) -> tuple[int, float] | None: ...
    def within_radius(
        self, query: _WeightArrayLike, radius: float
    ) -> tuple[npt.NDArray[np.uintp], npt.NDArray[np.float64]]: ...
    def within_radius_sq(
        self, query: _WeightArrayLike, radius_sq: float
    ) -> tuple[npt.NDArray[np.uintp], npt.NDArray[np.float64]]: ...
    def __repr__(self) -> str: ...

