from __future__ import annotations

from typing import final

import numpy as np
import numpy.typing as npt

from ._core_core import CsrGraph, Layout2d
from ._core_types import _DtypeLike, _MatrixArrayLike

__all__ = [
    "GripSolver",
    "KamadaKawaiSolver",
    "MaxentStressSolver",
    "SfcLayoutSolver",
    "StressMajorizationSolver",
]

@final
class GripSolver:
    def __new__(
        cls,
        graph: CsrGraph,
        *,
        rounds_min: int = 5,
        rounds_max: int = 30,
        local_neighborhood_size: int = 20,
        repulsion_scale: float = 0.05,
        edge_length: float = 1.0,
        temp_r: float = 0.15,
        temp_s: float = 3.0,
        seed: int = 42,
        dtype: _DtypeLike = "float64",
    ) -> GripSolver: ...
    def step(self, layout: Layout2d) -> str: ...
    def run_steps(self, layout: Layout2d, steps: int) -> str: ...
    def run(self, layout: Layout2d) -> str: ...
    @property
    def num_levels(self) -> int: ...
    @property
    def status(self) -> str: ...
    @property
    def iteration(self) -> int: ...
    @property
    def total_iterations(self) -> int: ...
    @property
    def is_finished(self) -> bool: ...
    @property
    def num_nodes(self) -> int: ...
    @property
    def dtype(self) -> str: ...
    def __repr__(self) -> str: ...

