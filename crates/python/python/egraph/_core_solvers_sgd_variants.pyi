@final
class Sgd2Solver:
    def __new__(
        cls,
        graph: CsrGraph,
        *,
        target: TargetKind = "layout2d",
        iterations: int = 60,
        eps: float = 0.01,
        step_scale: float = 1.0,
        batch_size: int = 4096,
        damping: float = 1e-4,
        seed: int = 42,
        dtype: _DtypeLike = "float64",
    ) -> Sgd2Solver: ...
    def step(self, layout: _AnyLayout) -> SolverStatus: ...
    def run_steps(self, layout: _AnyLayout, steps: int) -> SolverStatus: ...
    def run(self, layout: _AnyLayout) -> SolverStatus: ...
    def reset_schedule(
        self,
        *,
        iterations: int = 60,
        eps: float = 0.01,
        schedule: str = "squared",
        step_scale: float = 1.0,
        max_mu: float | None = None,
        seed: int = 42,
    ) -> None: ...
    def run_schedule_window(
        self,
        layout: _AnyLayout,
        start_iter: int,
        count: int,
    ) -> SolverStatus: ...
    @property
    def target(self) -> TargetKind: ...
    @property
    def status(self) -> SolverStatus: ...
    @property
    def iteration(self) -> int: ...
    @property
    def total_iterations(self) -> int | None: ...
    @property
    def is_finished(self) -> bool: ...
    @property
    def num_nodes(self) -> int: ...
    @property
    def num_springs(self) -> int: ...
    @property
    def current_eta(self) -> float: ...
    @property
    def dtype(self) -> str: ...
    def __repr__(self) -> str: ...

