{
  "name": "egraph",
  "version": "6.0.0-alpha.4",
  "collaborators": [
    "Yosuke Onoue <onoue@likr-lab.com>"
  ],
  "description": "Fast single-threaded graph drawing and layout library in Rust and WebAssembly.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/likr/egraph-rs/tree/master/crates/wasm"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "pkg/index.js",
    "pkg/index.d.ts",
    "pkg/egraph_wasm.js",
    "pkg/egraph_wasm.d.ts",
    "pkg/egraph_wasm.node.js",
    "pkg/egraph_wasm_bg.wasm",
    "README.md",
    "LICENSE"
  ],
  "main": "./pkg/egraph_wasm.node.js",
  "types": "./pkg/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./pkg/index.d.ts",
        "default": "./pkg/egraph_wasm.node.js"
      },
      "browser": {
        "types": "./pkg/index.d.ts",
        "default": "./pkg/index.js"
      },
      "default": {
        "types": "./pkg/index.d.ts",
        "default": "./pkg/index.js"
      }
    },
    "./egraph_wasm_bg.wasm": "./pkg/egraph_wasm_bg.wasm"
  },
  "scripts": {
    "build": "wasm-pack build --no-opt --target web --profile wasm-release -d pkg . && node scripts/assemble_pkg.mjs && wasm-opt -Oz --enable-bulk-memory --enable-nontrapping-float-to-int pkg/egraph_wasm_bg.wasm -o pkg/egraph_wasm_bg.wasm",
    "docs": "typedoc",
    "test:smoke": "node tests/node_esm_smoke.mjs"
  },
  "devDependencies": {
    "typedoc": "^0.28.20"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
