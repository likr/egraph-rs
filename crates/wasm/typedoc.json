{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./pkg/index.d.ts"],
  "out": "./docs",
  "name": "egraph (WebAssembly / TypeScript)",
  "readme": "./README.md",
  "excludePrivate": true,
  "excludeInternal": true,
  "skipErrorChecking": true,
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"]
  }
}
