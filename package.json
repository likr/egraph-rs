{
  "name": "egraph-workspace",
  "author": "Yosuke Onoue <onoue@likr-lab.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "crates/wasm",
    "examples/web"
  ],
  "scripts": {
    "wasm:build": "npm --prefix crates/wasm run build",
    "wasm:docs": "npm --prefix crates/wasm run docs",
    "wasm:test": "npm --prefix crates/wasm run test:smoke",
    "examples:dev": "npm --prefix examples/web run dev",
    "examples:build": "npm --prefix examples/web run build",
    "start": "npm run examples:dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/likr/egraph-rs.git"
  },
  "bugs": {
    "url": "https://github.com/likr/egraph-rs/issues"
  },
  "homepage": "https://github.com/likr/egraph-rs#readme"
}
